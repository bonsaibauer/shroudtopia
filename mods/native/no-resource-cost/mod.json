{
  "id": "mod.no-resource-cost",
  "name": "Shroudtopia No Resource Cost",
  "version": "1.0.0",
  "requires": {
    "capabilities": [
      "shroudtopia.runtime.patches"
    ]
  },
  "shroudtopia": {
    "abi": "1.0",
    "entrypoint": "ShroudtopiaCreateModV1",
    "binary": "shroudtopia-no-resource-cost.dll",
    "target": "both",
    "default": {
      "active": false
    }
  },
  "description": "Sets the requested resource count to zero for crafting and building when the game signature matches."
}
