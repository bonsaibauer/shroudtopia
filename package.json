{
  "name": "shroudtopia-documentation",
  "private": true,
  "scripts": {
    "docs:validate": "node docs/tools/validate-api.mjs",
    "docs:generate": "node docs/tools/generate-reference.mjs",
    "docs:examples": "node docs/tools/validate-examples.mjs",
    "docs:i18n": "node docs/tools/validate-localization.mjs",
    "docs:explorer": "node docs/tools/build-explorer.mjs",
    "docs:build": "node docs/tools/build-docs.mjs",
    "docs:serve": "node tools/api-playground-host.mjs",
    "sandbox:build": "cargo build --manifest-path src/assets/Cargo.toml --release --bin shroudtopia-inspect",
    "sandbox:verify": "python tools/asset-engine-smoke.py src/assets/target/release/shroudtopia.dll",
    "docs:check": "npm run docs:generate && npm run docs:validate && npm run docs:examples && npm run docs:i18n && npm run docs:explorer && npm run docs:build"
  }
}
