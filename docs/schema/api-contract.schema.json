{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shroudtopia.dev/schema/api-contract.schema.json",
  "title": "Shroudtopia public API documentation contract",
  "type": "object",
  "required": ["id", "version", "status", "header", "title", "summary", "types", "functions"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["stable", "experimental", "planned", "unavailable"] },
    "header": { "type": "string", "pattern": "^api/include/shroudtopia/.+\\.h$" },
    "capability": { "type": ["string", "null"] },
    "provider": { "$ref": "#/$defs/localized" },
    "title": { "$ref": "#/$defs/localized" },
    "summary": { "$ref": "#/$defs/localized" },
    "types": { "type": "array", "items": { "$ref": "#/$defs/apiType" } },
    "functions": { "type": "array", "items": { "$ref": "#/$defs/function" } }
  },
  "$defs": {
    "localized": {
      "type": "object",
      "required": ["en", "de"],
      "additionalProperties": false,
      "properties": { "en": { "type": "string" }, "de": { "type": "string" } }
    },
    "field": {
      "type": "object",
      "required": ["name", "type", "description"],
      "properties": {
        "name": { "type": "string" }, "type": { "type": "string" },
        "description": { "$ref": "#/$defs/localized" }, "rules": { "$ref": "#/$defs/localized" },
        "ownership": { "$ref": "#/$defs/localized" }, "since": { "type": "string" }
      }
    },
    "apiType": {
      "type": "object", "required": ["name", "kind", "description"],
      "properties": {
        "name": { "type": "string" }, "kind": { "enum": ["struct", "enum", "handle", "alias", "constant"] },
        "description": { "$ref": "#/$defs/localized" }, "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "values": { "type": "array", "items": { "$ref": "#/$defs/field" } }
      }
    },
    "parameter": {
      "allOf": [{ "$ref": "#/$defs/field" }, {
        "type": "object", "required": ["direction", "required"],
        "properties": { "direction": { "enum": ["in", "out", "inout"] }, "required": { "type": "boolean" } }
      }]
    },
    "result": {
      "type": "object", "required": ["code", "description"],
      "properties": { "code": { "type": "string", "pattern": "^ST_RESULT_" }, "description": { "$ref": "#/$defs/localized" } }
    },
    "function": {
      "type": "object",
      "required": ["name", "signature", "since", "status", "summary", "threading", "ownership", "parameters", "results", "example"],
      "properties": {
        "name": { "type": "string" }, "signature": { "type": "string" }, "since": { "type": "string" },
        "status": { "enum": ["stable", "experimental", "planned", "unavailable"] },
        "summary": { "$ref": "#/$defs/localized" }, "threading": { "$ref": "#/$defs/localized" },
        "ownership": { "$ref": "#/$defs/localized" }, "sideEffects": { "$ref": "#/$defs/localized" },
        "permission": { "type": ["string", "null"] },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "results": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/result" } },
        "example": { "type": "string", "minLength": 1 }
      }
    }
  }
}
