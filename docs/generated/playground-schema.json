{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Shroudtopia API Explorer invocation",
  "type": "object",
  "required": [
    "service",
    "function",
    "arguments"
  ],
  "properties": {
    "service": {
      "type": "string",
      "enum": [
        "actions",
        "api",
        "assets",
        "capabilities",
        "commands",
        "core",
        "events",
        "lifecycle",
        "logging",
        "runtime-patches",
        "services",
        "settings",
        "ui"
      ]
    },
    "function": {
      "type": "string"
    },
    "arguments": {
      "type": "object"
    },
    "mode": {
      "enum": [
        "validate",
        "sandbox",
        "live-local"
      ],
      "default": "validate"
    }
  },
  "additionalProperties": false
}
